# ---------------------- БАЗА ДАННЫХ ----------------------
def db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with db() as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS users(
            id INTEGER PRIMARY KEY, username TEXT, balance INTEGER DEFAULT 0);
        CREATE TABLE IF NOT EXISTS tasks(
            id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT,
            channel TEXT, day TEXT);
        CREATE TABLE IF NOT EXISTS completions(
            user_id INTEGER, task_id INTEGER, PRIMARY KEY(user_id, task_id));
        CREATE TABLE IF NOT EXISTS withdrawals(
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER,
            amount INTEGER, price_cents INTEGER, pattern TEXT,
            status TEXT DEFAULT 'pending');
        CREATE TABLE IF NOT EXISTS star_payments(
            charge_id TEXT PRIMARY KEY, user_id INTEGER, gold INTEGER, stars INTEGER);
        CREATE TABLE IF NOT EXISTS ton_deposits(
            tx_hash TEXT PRIMARY KEY, user_id INTEGER, ton REAL, gold INTEGER);
        """)


def get_balance(uid: int) -> int:
    with db() as c:
        r = c.execute("SELECT balance FROM users WHERE id=?", (uid,)).fetchone()
        return r["balance"] if r else 0


def add_balance(uid: int, amount: int):
    with db() as c:
        c.execute("INSERT OR IGNORE INTO users(id) VALUES(?)", (uid,))
        c.execute("UPDATE users SET balance = balance + ? WHERE id=?", (amount, uid))


def try_spend(uid: int, amount: int) -> bool:
    """Атомарно списывает голду, только если хватает баланса."""
    with db() as c:
        cur = c.execute(
            "UPDATE users SET balance = balance - ? WHERE id=? AND balance >= ?",
            (amount, uid, amount))
        return cur.rowcount == 1


def is_admin(uid: int) -> bool:
    return uid in ADMIN_IDS


def fmt_price(cents: int) -> str:
    return f"{cents // 100}.{cents % 100:02d}"


def unique_price_cents(amount: int) -> int:
    """Цена такая, чтобы после комиссии маркета пользователь получил ровно amount
    (amount / 0.8 при комиссии 20%), плюс уникальные копейки."""
    base = -(-amount * 100 * 100 // (100 - MARKET_FEE))
    with db() as c:
        busy = {r["price_cents"] for r in c.execute(
            "SELECT price_cents FROM withdrawals WHERE status='pending'")}
    options = [base + k for k in range(1, 100) if base + k not in busy]
    if not options:
        raise RuntimeError("Нет свободных копеек для этой суммы")
    return random.choice(options)


