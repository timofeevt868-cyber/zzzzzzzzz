@router.callback_query(F.data == "tasks")
async def show_tasks(cb: CallbackQuery):
    today = date.today().isoformat()
    with db() as c:
        tasks = c.execute("SELECT * FROM tasks WHERE day=?", (today,)).fetchall()
        done = {r["task_id"] for r in c.execute(
            "SELECT task_id FROM completions WHERE user_id=?", (cb.from_user.id,))}
    if not tasks:
        await cb.message.answer("На сегодня заданий нет. Загляни позже!")
        return await cb.answer()
    for t in tasks:
        if t["id"] in done:
            await cb.message.answer(f"✅ {t['title']} — выполнено")
            continue
        url = f"https://t.me/{t['channel'].lstrip('@')}"
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="📢 Перейти в канал", url=url)],
            [InlineKeyboardButton(text="✔️ Проверить подписку",
                                  callback_data=f"check:{t['id']}")],
        ])
        await cb.message.answer(f"📌 {t['title']}\nНаграда: {TASK_REWARD} голды", reply_markup=kb)
    await cb.answer()


@router.callback_query(F.data.startswith("check:"))
async def check_task(cb: CallbackQuery, bot: Bot):
    task_id = int(cb.data.split(":")[1])
    with db() as c:
        t = c.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
        already = c.execute("SELECT 1 FROM completions WHERE user_id=? AND task_id=?",
                            (cb.from_user.id, task_id)).fetchone()
    if not t:
        return await cb.answer("Задание не найдено", show_alert=True)
    if already:
        return await cb.answer("Ты уже получил награду за это задание", show_alert=True)
    try:
        member = await bot.get_chat_member(t["channel"], cb.from_user.id)
        subscribed = member.status in ("member", "administrator", "creator")
    except Exception:
        return await cb.answer("Не могу проверить подписку. Сообщи админу.", show_alert=True)
    if not subscribed:
        return await cb.answer("Ты ещё не подписался ❌", show_alert=True)
    with db() as c:
        c.execute("INSERT OR IGNORE INTO users(id) VALUES(?)", (cb.from_user.id,))
        c.execute("INSERT INTO completions(user_id, task_id) VALUES(?,?)",
                  (cb.from_user.id, task_id))
    add_balance(cb.from_user.id, TASK_REWARD)
    await cb.message.edit_text(f"✅ {t['title']} — выполнено! +{TASK_REWARD} голды")
    await cb.answer()


