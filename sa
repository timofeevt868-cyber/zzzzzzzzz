@router.message(Coin.bet)
async def coin_bet(m: Message, state: FSMContext):
    if not (m.text and m.text.isdigit()):
        return await m.answer("Введи целое число.")
    bet = int(m.text)
    if not COIN_MIN_BET <= bet <= COIN_MAX_BET:
        return await m.answer(f"Ставка должна быть от {COIN_MIN_BET} до {COIN_MAX_BET}.")
    if bet > get_balance(m.from_user.id):
        return await m.answer("Недостаточно голды.")
    await state.update_data(bet=bet)
    await state.set_state(Coin.side)
    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="🦅 Орёл", callback_data="coin_side:heads"),
        InlineKeyboardButton(text="🔘 Решка", callback_data="coin_side:tails")]])
    await m.answer(f"Ставка {bet} голды. Выбери сторону:", reply_markup=kb)


@router.callback_query(Coin.side, F.data.startswith("coin_side:"))
async def coin_play(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    await state.clear()
    bet = data.get("bet")
    if not bet:
        return await cb.answer()
    side = cb.data.split(":")[1]
    if not try_spend(cb.from_user.id, bet):
        await cb.message.answer("Недостаточно голды.")
        return await cb.answer()
    win = rng.random() < COIN_WIN_CHANCE
    names = {"heads": "🦅 Орёл", "tails": "🔘 Решка"}
    result = side if win else ("tails" if side == "heads" else "heads")
    if win:
        add_balance(cb.from_user.id, bet * 2)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🔁 Играть ещё", callback_data="coin")],
        [InlineKeyboardButton(text="🏠 Меню", callback_data="menu")]])
    await cb.message.answer(
        f"Выпало: {names[result]}\n"
        f"{'🎉 Ты выиграл +' + str(bet) + ' голды!' if win else '😢 Проигрыш −' + str(bet) + ' голды'}\n"
        f"Баланс: {get_balance(cb.from_user.id)}", reply_markup=kb)
    await cb.answer()


