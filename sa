               f"Сумма вывода: {data['amount']} голды\n"
               f"Скин: {SKIN_NAME}\n"
               f"Паттерн: {m.text.strip()}\n"
               f"Цена на маркете: {fmt_price(data['price'])}")
    for admin in ADMIN_IDS:
        try:
            await bot.send_photo(admin, data["avatar"], caption=caption, reply_markup=wd_kb(wid))
        except Exception:
            logging.exception("Не удалось отправить заявку админу %s", admin)


