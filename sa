@router.callback_query(F.data.startswith(("wd_yes:", "wd_rej:")))
async def withdraw_final(cb: CallbackQuery, bot: Bot):
    """Шаг 2: окончательное подтверждение админом."""
    if not is_admin(cb.from_user.id):
        return await cb.answer("Нет доступа", show_alert=True)
    action, wid = cb.data.split(":")
    wid = int(wid)
    with db() as c:
        w = c.execute("SELECT * FROM withdrawals WHERE id=?", (wid,)).fetchone()
        if not w or w["status"] != "pending":
            return await cb.answer("Заявка уже обработана", show_alert=True)
        status = "paid" if action == "wd_yes" else "rejected"
        c.execute("UPDATE withdrawals SET status=? WHERE id=?", (status, wid))
    if status == "paid":
        await bot.send_message(w["user_id"], f"✅ Админ подтвердил вывод {w['amount']} голды. Спасибо!")
        label = f"✅ Выплата подтверждена ({cb.from_user.id})"
    else:
        add_balance(w["user_id"], w["amount"])
        await bot.send_message(w["user_id"],
                               f"❌ Заявка отклонена. {w['amount']} голды возвращены на баланс.")
        label = f"❌ Отклонено ({cb.from_user.id})"
    await cb.message.edit_caption(caption=(cb.message.caption or "") + f"\n\n{label}")
    await cb.answer()


