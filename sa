@router.callback_query(F.data.startswith("nft_price:"))
async def nft_price_start(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return await cb.answer("Нет доступа", show_alert=True)
    nid = int(cb.data.split(":")[1])
    with db() as c:
        req = c.execute("SELECT * FROM nft_topups WHERE id=?", (nid,)).fetchone()
    if not req or req["status"] != "pending":
        return await cb.answer("Заявка уже обработана", show_alert=True)
    await state.set_state(NftCredit.amount)
    await state.update_data(nid=nid)
    await cb.message.answer(
        f"Заявка #{nid}, подарок «{req['gift_name']}».\n"
        "Введи сумму голды, которую начислишь пользователю ПОСЛЕ получения подарка:")
    await cb.answer()


@router.message(NftCredit.amount)
async def nft_price_set(m: Message, state: FSMContext, bot: Bot):
    if not is_admin(m.from_user.id):
        return
    if not (m.text and m.text.isdigit()) or int(m.text) <= 0:
        return await m.answer("Введи положительное целое число.")
    amount = int(m.text)
    data = await state.get_data()
    await state.clear()
    nid = data["nid"]
    with db() as c:
        req = c.execute("SELECT * FROM nft_topups WHERE id=?", (nid,)).fetchone()
        if not req or req["status"] != "pending":
            return await m.answer("Заявка уже обработана.")
        c.execute("UPDATE nft_topups SET status='quoted', amount=? WHERE id=?", (amount, nid))
    await m.answer(f"✅ Цена {amount} голды назначена по заявке #{nid}. "
                   "Пользователю отправлено уведомление.")
    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="📤 Я отправил подарок", callback_data=f"nft_sent:{nid}")]])
    try:
        await bot.send_message(
            req["user_id"],
            f"💰 За подарок «{req['gift_name']}» администратор начислит тебе "
            f"<b>{amount} голды</b>.\n\n"
            f"Теперь отправь сам подарок на профиль @{ADMIN_GIFT_USERNAME} в Telegram "
            "(функция «Подарить подарок»), затем нажми кнопку ниже и пришли "
            "скриншот подтверждения отправки.",
            parse_mode="HTML", reply_markup=kb)
    except Exception:
        pass


