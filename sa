async def adm_tasks(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return await cb.answer()
    with db() as c:
        rows = c.execute("SELECT * FROM tasks WHERE day >= ? ORDER BY day",
                         (date.today().isoformat(),)).fetchall()
    if not rows:
        await cb.message.answer("Заданий нет.")
    for t in rows:
        kb = InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="🗑 Удалить", callback_data=f"adm_del:{t['id']}")]])
        await cb.message.answer(f"#{t['id']} | {t['day']} | {t['channel']}\n{t['title']}",
