async def check_ton(bot: Bot):
    headers = {"X-API-Key": TONCENTER_API_KEY} if TONCENTER_API_KEY else {}
    params = {"address": TON_WALLET, "limit": 30}
    async with aiohttp.ClientSession(headers=headers) as s:
        async with s.get("https://toncenter.com/api/v2/getTransactions", params=params,
                         timeout=aiohttp.ClientTimeout(total=20)) as r:
            data = await r.json()
    if not data.get("ok"):
        logging.warning("toncenter: %s", data)
        return
    for tx in reversed(data["result"]):
        in_msg = tx.get("in_msg") or {}
        if not in_msg.get("source"):
            continue  # исходящие / служебные
        tx_hash = tx["transaction_id"]["hash"]
        ton = int(in_msg.get("value", "0")) / 1e9
        comment = (in_msg.get("message") or "").strip()
        mt = re.fullmatch(r"G(\d+)", comment)
        gold = int(ton * GOLD_PER_TON)
        uid = int(mt.group(1)) if mt else None
        credited = bool(uid and gold >= 1)
        with db() as c:
            cur = c.execute(
                "INSERT OR IGNORE INTO ton_deposits(tx_hash, user_id, ton, gold) VALUES(?,?,?,?)",
                (tx_hash, uid if credited else None, ton, gold if credited else 0))
            new = cur.rowcount == 1
        if not new:
            continue
        if credited:
            add_balance(uid, gold)
            try:
                await bot.send_message(uid, f"✅ Получено {ton:g} TON. +{gold} голды зачислено.")
            except Exception:
                pass
        else:
            for admin in ADMIN_IDS:
                try:
                    await bot.send_message(
                        admin, f"⚠️ TON-платёж без опознанного комментария: {ton:g} TON, "
                               f"комментарий: «{comment}», от {in_msg.get('source')}. "
                               f"Зачисли вручную через админ-панель.")
                except Exception:
                    pass


async def ton_watcher(bot: Bot):
    if not TON_WALLET:
        logging.info("TON_WALLET не задан — проверка TON отключена")
        return
    while True:
        try:
            await check_ton(bot)
        except Exception:
            logging.exception("Ошибка проверки TON")
        await asyncio.sleep(30)


