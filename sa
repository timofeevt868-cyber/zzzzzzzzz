@router.message(AddTask.day)
async def addtask_day(m: Message, state: FSMContext):
    t = (m.text or "").strip().lower()
    if t == "сегодня":
        day = date.today().isoformat()
    elif t == "завтра":
        day = (date.today() + timedelta(days=1)).isoformat()
    else:
        try:
            day = date.fromisoformat(t).isoformat()
        except ValueError:
            return await m.answer("Неверный формат. Пример: 2026-11-05")
    await state.update_data(day=day)
    await state.set_state(AddTask.channel)
    await m.answer("Отправь @username публичного канала (бот должен быть в нём админом):")


@router.message(AddTask.channel)
