                                reply_markup=kb)
    await cb.answer()


@router.callback_query(F.data.startswith("adm_del:"))
async def adm_del(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return await cb.answer()
    with db() as c:
        c.execute("DELETE FROM tasks WHERE id=?", (int(cb.data.split(":")[1]),))
    await cb.message.edit_text("🗑 Удалено")
    await cb.answer()


# ---------------------- ЗАПУСК ----------------------
async def main():
    # --- проверка настроек, чтобы сразу было понятно, что не так ---
    if not re.fullmatch(r"\d+:[\w-]+", BOT_TOKEN.strip()):
        print("\n❌ Не указан токен бота.\n"
              "   Открой bot.py и в самом верху впиши токен от @BotFather в BOT_TOKEN.\n")
        return
    if not ADMIN_IDS or 0 in ADMIN_IDS:
        print("\n⚠️  Не указан ID админа — админ-панель работать не будет.\n"
              "   Впиши свой ID (узнать у @userinfobot) в ADMIN_IDS в начале bot.py.\n")

    init_db()
    bot = Bot(BOT_TOKEN.strip())
    try:
        me = await bot.get_me()
    except TelegramUnauthorizedError:
        print("\n❌ Токен неверный. Скопируй его заново у @BotFather.\n")
        await bot.session.close()
        return
    except Exception as e:
        print(f"\n❌ Не удалось подключиться к Telegram: {e}\n"
              "   Проверь интернет/VPN и попробуй снова.\n")
        await bot.session.close()
        return

    print(f"✅ Бот запущен: @{me.username}. Остановить — Ctrl+C.")
    await bot.delete_webhook(drop_pending_updates=True)
    for admin in ADMIN_IDS:
        if admin == 0:
            continue
        try:
            await bot.send_message(admin, "✅ Бот запущен. Админ-панель: /admin")
        except Exception:
            print(f"⚠️  Не могу написать админу {admin}: открой бота и нажми /start, "
                  "и проверь, что ID верный.")

    dp = Dispatcher(storage=MemoryStorage())
    dp.include_router(router)
    asyncio.create_task(ton_watcher(bot))
    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("Бот остановлен.")
